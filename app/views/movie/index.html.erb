<div class="movies-container">
  <%= render 'movie/navbar' %>
  <div class="movie-display">
    <div class="movie-img-banner">
      <h1>Watchlist Tracker</h1>
      <p>Your Personalize Watchlist Tracker with over thousands of movies available.</p>
    </div>
    <div class="cards-container">
        <h1>Popular Movies</h1>
      <div class="movie-cards">
        <% @movies.sample(5).each do |movie| %>
          <%= image_tag(movie.poster_url, alt: movie.title, class: 'movie-poster') %>
          <% end %>
      </div>
    </div>
    <div class="cards-container">
      <h1>Top Rated Movies</h1>
      <div class="movie-cards">
        <% @movies.sample(5).each do |movie| %>
          <%= image_tag(movie.poster_url, alt: movie.title, class: 'movie-poster') %>
          <% end %>
      </div>
    </div>
    <div class="cards-container">
      <h1>Random Movies You'll Love</h1>
      <div class="movie-cards">
        <% @movies.sample(5).each do |movie| %>
          <%= image_tag(movie.poster_url, alt: movie.title, class: 'movie-poster') %>
          <% end %>
      </div>
    </div>
    <div class="cards-container">
      <h1>Discover Movies</h1>
      <div class="movie-cards">
        <% @movies.sample(5).each do |movie| %>
          <%= image_tag(movie.poster_url, alt: movie.title, class: 'movie-poster') %>
          <% end %>
      </div>
    </div>
  </div>
</div>
