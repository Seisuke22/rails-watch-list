<div class="show-container">
  <div class="show-navbar">
    <h2>Watchlist Tracker</h2>
    <div class="show-navbar-text">
      <p><%= link_to "Home", root_path, class: "show_navbar_text" %></p>
      <p>Movies</p>
    </div>
    <input type="text" class="search-bar" placeholder="Search...">
    <button type="button" class="signin-button signin-button"><strong>Sign in</strong></button>
    <button type="button" class="signup-button btn btn-primary"><strong>Sign Up</strong></button>
  </div>
  <hr>
<div class="page-name">
  <h3>My Watch List</h3>
  <%= link_to "Create list", new_list_path, class: "create-list btn btn-primary" %>
</div>
<div class="cards">
  <% @lists.each do |list| %>
    <% if list.photo.attached? %>
      <a href="<%= list_path(list) %>" class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(<%= cl_image_path list.photo.key%>); text-decoration: none;">
        <%= list.name %>
      </a>
    <% else %>
      <a href="<%= list_path(list) %>" class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(https://raw.githubusercontent.com/lewagon/fullstack-images/master/uikit/breakfast.jpg); text-decoration: none;">
        <%= list.name %>
      </a>
    <% end %>
  <% end %>
</div>
