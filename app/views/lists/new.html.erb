<div class="form">
  <div class="show-navbar">
    <h2>Watchlist Tracker</h2>
    <div class="show-navbar-text">
      <p><%= link_to "Home", root_path, class: "show_navbar_text" %></p>
      <p>Movies</p>
    </div>
    <input type="text" class="search-bar" placeholder="Search...">
    <button type="button" class="signin-button signin-button"><strong>Sign in</strong></button>
    <button type="button" class="signup-button btn btn-primary"><strong>Sign Up</strong></button>
  </div>
  <hr>
  <div class="form-size">
    <%= simple_form_for(@list) do |t| %>
      <div class="text-area">
        <h2 class="action-list">Add a new List</h2>
        <div class="text"><%= t.input :name %></div>
        <div class="text"><%= t.input :photo, as: :file %></div>
        <%= t.submit "Add", class: "btn btn-dark-blue" %>
      </div>
    <% end %>
  </div>
</div>
