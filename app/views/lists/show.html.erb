<div class="show-navbar">
  <h2>Watchlist Tracker</h2>
  <div class="show-navbar-text">
    <p><%= link_to "Home", root_path, class: "show_navbar_text" %></p>
    <p>Movies</p>
  </div>
  <input type="text" class="search-bar" placeholder="Search...">
  <button type="button" class="signin-button"><strong>Sign in</strong></button>
  <button type="button" class="signup-button btn btn-primary"><strong>Sign Up</strong></button>
</div>
<hr>
<div class="page-name">
  <h3 class="action-show"><%= @list.name %> Page </h3>
  <%= link_to "Add bookmark", new_list_bookmark_path(@list), class: "add-bookmark-btn" %>
</div>

<div class="container">
  <% if @bookmarks.empty? %>
    <div class="d-flex justify-content-center">
      <%= image_tag 'empty-folder_2456758.png', alt: 'Empty folder picture' %>
    </div>
  <% else %>
    <% @bookmarks.each do |bookmark| %>
      <div class="card-product">
        <img src="<%= bookmark.movie.poster_url %>" class="bookmark-poster" />
        <div class="trash-icon">
          <%= button_to '🗑️', list_bookmark_path(@list, bookmark), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: 'no-underline' %>
        </div>
        <div class="overlay">
          <div class="overlay-content">
            <h2><%= bookmark.movie.title %></h2>
            <p>Rating: <strong><%= bookmark.movie.rating %></strong></p>
            <p>" <%= bookmark.comment %> "</p>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
