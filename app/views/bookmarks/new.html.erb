<div class="form">
  <div class="show-navbar">
    <h2>Watchlist Tracker</h2>
    <div class="show-navbar-text">
      <p><%= link_to "Home", root_path, class: "show_navbar_text" %></p>
      <p>Movies</p>
      <p>My lists</p>
    </div>
    <input type="text" class="search-bar" placeholder="Search...">
    <button type="button" class="signin-button signin-button"><strong>Sign in</strong></button>
    <button type="button" class="signup-button btn btn-primary"><strong>Sign Up</strong></button>
  </div>
  <hr>
  <div class="form-size">
    <%= simple_form_for [@movie || @list, @bookmark] do |t| %>
      <div class="text-area">
        <% if params[:list_id] %>
          <div class="new-form">
            <% @list = List.find(params[:list_id]) if @list.nil? %>
            <p class="movie-to-add">Adding to: <strong><%= @list.name if @list %></strong></p>
            <% if @list.photo.attached? %>
              <div class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(<%= cl_image_path @list.photo.key%>); text-decoration: none;">
                <%= @list.name %>
              </div>
            <% else %>
              <div class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(https://raw.githubusercontent.com/lewagon/fullstack-images/master/uikit/breakfast.jpg); text-decoration: none;">
                <%= @list.name %>
              </div>
            <% end %>
            <%= t.input :movie_id, collection: Movie.all, label_method: :title, value_method: :id, prompt: 'Select a Movie' %>
            <%= t.input :comment %>
            <%= t.submit "Add", class: "btn btn-dark-blue" %>
          </div>
        <% else %>
          <div class="grid-container">
            <div class="new-form-left">
              <% @movie = Movie.find(params[:movie_id]) %>
              <%= image_tag(@movie.poster_url, class: 'show-movie-poster-form') %>
              <h3> <strong><%= @movie.title if @movie %></strong></h3>
            </div>
            <div class="new-form-right">
              <h2 class="action-title">Bookmark a Movie</h2>
               <p class="movie-to-add">Movie to add: <strong><%= @movie.title if @movie %></strong></p>
              <%= t.input :list_id, collection: List.all, label_method: :name, value_method: :id, prompt: 'Select a List' %>
              <%= t.input :comment %>
              <%= t.submit "Add", class: "btn btn-dark-blue" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
