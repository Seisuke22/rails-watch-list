<div class="navbar-left">
  <div class="navbar-components">
    <h1 id="web-name">Watchlist</h1>
    <div class="navbar-category">
      <h5 class="category-name">Menu</h5>
      <h4 class="text-components"><i class="fa-solid fa-house"></i> Home</h4>
      <h4 class="text-components"><i class="fa-solid fa-heart"></i> Celebrities</h4>
      <h4 class="text-components"><i class="fa-solid fa-magnifying-glass"></i> Discover</h4>
    </div>
    <div class="navbar-category">
      <h5 class="category-name">Library</h5>
      <h4 class="text-components"><i class="fa-solid fa-bars"></i> Genre</h4>
      <h4 class="text-components"><i class="fa-solid fa-ranking-star"></i> Top Rated Movies</h4>
      <h4 class="text-components"><i class="fa-solid fa-star"></i> Popular Movies</h4>
    </div>
    <div class="navbar-category">
      <h5 class="category-name">My Lists</h5>
      <h4 class="text-components"><i class="fa-solid fa-list"></i> Watchlists</h4>
      <h4 class="text-components"><i class="fa-solid fa-check"></i> Completed</h4>
    </div>
    <div class="navbar-category">
      <h5 class="category-name">General</h5>
      <h4 class="text-components"><i class="fa-solid fa-gear"></i> Settings</h4>
      <% if user_signed_in? %>
        <h4 class="text-components">
          <%= button_to destroy_user_session_path, method: :delete, form: { data: { turbo_method: :delete } }, style: "color: white; background-color: transparent; border: none; text-decoration: none; font: inherit; display: inline-flex; align-items: center; cursor: pointer; padding: 0;" do %>
          <i class="fa-solid fa-right-to-bracket" style="margin-right: 8px;"></i>
          Log out
      <% end %>
        </h4>
      <% else %>
        <h4 class="text-components">
          <i class="fa-solid fa-right-to-bracket"></i>
          <%= link_to "Login", new_user_session_path, style: "color: white; background-color: transparent; border: none; text-decoration: none; font: inherit; display: inline-flex; align-items: center; cursor: pointer; padding: 0;", class: "login-button" %>
        </h4>
      <% end %>
    </div>
  </div>
  <div class="add-watchlist-button">
    <button type="button" class="btn btn-primary"><strong>Create Watchlist</strong></button>
  </div>
</div>
