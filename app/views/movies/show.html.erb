<div class="show-container">
  <div class="show-navbar">
    <h2>Watchlist Tracker</h2>
    <div class="show-navbar-text">
      <p><%= link_to "Home", root_path, class: "navbar-texts-show" %></p>
      <p>Movies</p>
    </div>
    <input type="text" class="search-bar" placeholder="Search...">
    <button type="button" class="signin-button signin-button"><strong>Sign in</strong></button>
    <button type="button" class="signup-button btn btn-primary"><strong>Sign Up</strong></button>
  </div>
  <hr>
  <div class="overview-container">
    <div class="visual-info">
      <%= image_tag(@movie.poster_url, class: 'show-movie-poster') %>
      <button type="button" class="trailer-button btn"><strong>Trailer</strong></button>
      <button type="button" class="trailer-button btn"><strong>Add To Watchlist</strong></button>
    </div>
    <div class="text-info">
      <div class="show-text">
        <div class="upper-text">
          <h1><%= @movie.title %></h1>
          <button type="button" class="trailer-button btn" style="width: 380px;"><strong>Watch</strong></button>
        </div>
          <div class="lower-text">
            <h3>Overview</h3>
            <p><%= @movie.overview %></p>
          </div>
      </div>
      <div class="more-details">
        <p>Rating <span class="rating-value"><%= @movie.rating %></span></p>
        <p>Release Year <span class="release-year"><%= @movie.release_year %></span></p>
        <p>Genres <span class="genres"><%= @movie.genres %></span></p>
        <p>Duration <span class="duration"><%= @movie.runtime %></span></p>
      </div>
    <div class="actor-container">
      <h3>Top Casts</h3>
      <div class="actor-cards">
        <% @movie.actor_image.each_with_index do |actors_image, index| %>
          <div class="actor-card">
            <%= image_tag("#{actors_image}", alt: "Actor Image", class: "actor-images") %>
            <p><%= @movie.actor_name[index] %></p>
          </div>
        <% end %>
      </div>
    </div>

    </div>
  </div>
</div>
